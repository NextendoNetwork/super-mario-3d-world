# Transport profile: same-host, lan, or public-internet.
TRANSPORT_PROFILE=same-host

# NEX bind address and the address advertised to clients.
BIND_IP=127.0.0.1
NEXTENDO_HOST=127.0.0.1
AUTH_PORT=443
SECURE_PORT=60003

# NNCS needs two different bind addresses and two different advertised identities.
NNCS1_BIND_IP=127.0.0.1
NNCS2_BIND_IP=127.0.0.2
NNCS1_PUBLIC_IP=127.0.0.1
NNCS2_PUBLIC_IP=127.0.0.2

# Required for lan and public-internet. Both processes must see the same file.
NNCS_NAT_FILE=

CERT_FILE=cert.pem
KEY_FILE=key.pem
NEXTENDO_SECURE_PASSWORD=
NEXTENDO_ACCOUNT_URL=http://127.0.0.1:8080
NEXTENDO_SECRET=
NEXTENDO_INTERNAL_KEY=

# Optional compatibility for older clients that send a bare PID. Same-host only.
SM3DW_SAME_HOST_PIDS=
